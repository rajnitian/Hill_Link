# Demo mode is intentionally safe by default. Never set DEMO_MODE=false without reviewing security.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DEMO_MODE=true
NODE_ENV=development
VITE_API_URL=http://localhost:4000/api

# Persistent PostgreSQL (required when NODE_ENV=production)
DATABASE_URL=postgres://hilllink_user:change-me@localhost:5432/hilllink
DATABASE_SSL=false

# Production role tokens. Use long random secrets and keep them out of source control.
HOSPITAL_API_TOKEN=replace-with-a-long-random-token
DISPATCHER_API_TOKEN=replace-with-a-long-random-token
ADMIN_API_TOKEN=replace-with-a-long-random-token
HOSPITAL_VERIFICATION_MODE=disabled

# SMS_MODE remains mock unless an independently reviewed provider adapter is implemented.
SMS_MODE=mock
SMS_WEBHOOK_SECRET=replace-with-provider-webhook-secret
SMS_BATCH_SIZE=3
SMS_RESPONSE_TIMEOUT_MS=60000
# Live road/weather/ambulance providers are not implemented in this demo.
